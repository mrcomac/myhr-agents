# AWS / Bedrock — required by both the consumer (CV evaluation) and the
# job-enhancement FastAPI service. In alpha these come from the
# myhr-aws-secret Kubernetes Secret.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Locale used to instruct the LLM which language to respond in.
# Supported: en, en-US, en-GB, pt-BR, pt, es, es-ES, fr, de, it, nl, pl, ru,
# zh, ja, ko, ar.
LOCALE=en

# RabbitMQ — consumer only. In dev: amqp://guest:guest@localhost:5672/.
RABBITMQ_URL=

# Redis — consumer only. The URL omits the password; REDIS_PASSWORD is
# injected into the URL at runtime, matching how the Go services do it.
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# MinIO / S3-compatible object storage — consumer only.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
STORAGE_BUCKET=myhr-uploads

# Backend service URLs (consumer fetches job details and posts evaluations).
JOB_SERVICE_URL=http://localhost:8082
LOOP_SERVICE_URL=http://localhost:8083

# Soft daily cap on CV evaluations to prevent runaway Bedrock spend.
CV_EVAL_DAILY_LIMIT=100
